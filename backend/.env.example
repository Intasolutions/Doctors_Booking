# Copy to .env for local development.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Neon / PostgreSQL. Leave empty to use local SQLite.
DATABASE_URL=

# Public website, used in links inside messages.
CARESLOT_SITE_URL=http://localhost:3000
CARESLOT_BRAND=CareSlot
BOOKING_WINDOW_DAYS=14
MIN_LEAD_MINUTES=15

# WhatsApp Cloud API (Meta). Leave WHATSAPP_TOKEN empty for console mode:
# messages are logged, not sent, and the admin WhatsApp tester works.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_BUSINESS_NUMBER=919000000000
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TEMPLATE_LANGUAGE=en
