{
  "name": "careslot",
  "private": true,
  "description": "CareSlot: one command to run the API and website locally",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/run-api.mjs runserver 0.0.0.0:8000",
    "dev:web": "npm --prefix web run dev -- -H 0.0.0.0 -p 3000",
    "dev:app": "npm --prefix mobile start",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-data.ps1",
    "test": "node scripts/run-api.mjs test"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
